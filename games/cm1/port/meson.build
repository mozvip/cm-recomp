# Championship Manager (1992), native: the decompiled sources (src/, from
# ../decomp/src) on Linux with SDL3.
# Built from the repository's meson.build (meson setup build ../../.. -Dgame=cm1,
# which make does); see README.md.

game_name = 'cm1'
game_srcs = files(
  'src/144e.c', 'src/14d2.c', 'src/1680.c', 'src/67ee.c', 'src/6e68.c', 'src/7555.c',
  'src/7a28.c', 'src/7eeb.c', 'src/8352.c', 'src/88c9.c', 'src/9100.c', 'src/992a.c',
  'src/a1c3.c',
  'db.c')                 # the database, at start-up
# the data's names (../names.txt)
names = files('../names.txt')
